<UserControl x:Class="ClipSync.Windows.MainUI.Components.HistoryRow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Theme/Controls.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Border Style="{StaticResource Card}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Metadata}" ToolTip="{Binding FullTime}" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{Binding RevealLabel}" Command="{Binding RevealCommand}" Visibility="{Binding Sensitive,Converter={StaticResource BoolVisibility}}" Margin="12,0,0,0"/><Button Content="Copy" Command="{Binding CopyCommand}" Margin="8,0,0,0"/><Button Content="{Binding PinLabel}" Command="{Binding PinCommand}" Margin="8,0,0,0"/><Button Content="Delete" Command="{Binding DeleteCommand}" Foreground="{StaticResource Danger}" Margin="8,0,0,0"/></StackPanel></Grid></Border>
</UserControl>
