<UserControl x:Class="ClipSync.Windows.MainUI.Components.PairingPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Theme/Controls.xaml"/><ResourceDictionary Source="../Theme/Icons.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Border Style="{StaticResource Card}"><StackPanel>
  <TextBlock Text="Pair a new device" FontSize="16" FontWeight="SemiBold"/>
  <StackPanel Visibility="{Binding Active,Converter={StaticResource BoolVisibility}}" Margin="0,16,0,8">
   <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Code}" FontFamily="Consolas" FontSize="40" VerticalAlignment="Center"/><Button Style="{StaticResource IconButton}" Command="{Binding CopyCommand}" ToolTip="Copy pairing code" AutomationProperties.Name="Copy pairing code" Margin="12,0,0,0"><Path Data="{StaticResource CopyIcon}" Stroke="{StaticResource Text}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform"/></Button></StackPanel>
   <TextBlock Text="{Binding Countdown}" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
  </StackPanel>
  <TextBlock Text="Last code expired" Foreground="{StaticResource Paused}" FontSize="13" Visibility="{Binding Expired,Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0"/>
  <TextBlock Text="{Binding Hint}" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,12,0,16"/>
  <Button Content="{Binding ButtonLabel}" Command="{Binding GenerateCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource MainButton}"><Style.Triggers><DataTrigger Binding="{Binding IsPrimary}" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#172334"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
 </StackPanel></Border>
</UserControl>

