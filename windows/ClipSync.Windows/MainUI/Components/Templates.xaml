<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Theme/Controls.xaml"/></ResourceDictionary.MergedDictionaries>
 <ControlTemplate x:Key="EmptyTemplate" TargetType="ContentControl"><StackPanel><TextBlock Text="{Binding Title}" FontSize="18"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/></StackPanel></ControlTemplate>
 <ControlTemplate x:Key="StatusTemplate" TargetType="ContentControl"><Border CornerRadius="10" Background="{Binding Tint}" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="{Binding Color}" VerticalAlignment="Center" Margin="0,0,12,0"/><StackPanel><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel></StackPanel><Button Grid.Column="1" Margin="16,0,0,0" Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" Visibility="{Binding HasAction,Converter={StaticResource BoolVisibility}}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource MainButton}"><Style.Triggers><DataTrigger Binding="{Binding IsPrimary}" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#172334"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid></Border></ControlTemplate> <ControlTemplate x:Key="DeviceTemplate" TargetType="ContentControl"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel></ControlTemplate>
 <ControlTemplate x:Key="DirectionTemplate" TargetType="ContentControl"><Border Background="{DynamicResource Raised}" CornerRadius="4" Padding="8,3"><ContentPresenter/></Border></ControlTemplate>
</ResourceDictionary>

