<Window x:Class="ClipSync.Windows.MainUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:infra="clr-namespace:ClipSync.Windows.MainUI.Infrastructure" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="FerryClip" Icon="pack://application:,,,/FerryClip;component/Assets/ferryclip.ico" Width="1100" Height="720" MinWidth="900" MinHeight="600" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource Base}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme/Tokens.xaml"/><ResourceDictionary Source="Theme/Controls.xaml"/><ResourceDictionary Source="Theme/Icons.xaml"/></ResourceDictionary.MergedDictionaries><infra:IconConverter x:Key="IconConverter"/></ResourceDictionary></Window.Resources>
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" LastChildFill="False" Background="{StaticResource Base}"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="─" Style="{StaticResource ChromeButton}" Width="46" Padding="0" Click="Minimize" ToolTip="Minimize"/><Button Content="□" Style="{StaticResource ChromeButton}" Width="46" Padding="0" Click="Maximize" ToolTip="Maximize or restore"/><Button Content="×" Style="{StaticResource ChromeButton}" Tag="Close" Width="46" Padding="0" Click="CloseWindow" ToolTip="Close"/></StackPanel></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="240"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Ellipse x:Name="CompactStateDot" Width="8" Height="8" Fill="{Binding StatusBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" ToolTip="{Binding StatusTitle}" Visibility="Collapsed"/><Grid x:Name="SidebarBody" Margin="16,20,16,20"><Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition/><RowDefinition Height="84"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal"><Image Source="/FerryClip;component/Assets/ferryclip_logo.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top"/><TextBlock x:Name="Wordmark" Text="FerryClip" FontSize="24" FontWeight="SemiBold" Margin="10,3,0,0"/></StackPanel>
    <ItemsControl x:Name="NavItems" Grid.Row="1" ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding Command}" ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Tag" Value="Selected"/><Setter Property="Background" Value="{StaticResource Raised}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><Path Data="{Binding Icon,Converter={StaticResource IconConverter},ConverterParameter={x:Reference PageHost}}" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Margin="0,0,12,0"/><TextBlock Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Text="{Binding Title}" Tag="NavLabel" VerticalAlignment="Center"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Border x:Name="SidebarFooter" Grid.Row="2" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8,0,8"><StackPanel><Button x:Name="StatusRowButton" Command="{Binding DevicesCommand}" ToolTip="Open devices" AutomationProperties.Name="{Binding StatusTitle, StringFormat=Connection status: {0}. Open devices}" Background="Transparent" BorderBrush="Transparent" Padding="0" MinHeight="42" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding StatusTitle}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusDescription}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,1,0,0"/></StackPanel></Grid></Button><Button Style="{StaticResource QuietLink}" Content="{Binding FooterLinkText}" Command="{Binding WebsiteCommand}" FontSize="12" Foreground="{StaticResource Muted}" Background="Transparent" BorderBrush="Transparent" Padding="0" MinHeight="20" HorizontalAlignment="Left" Margin="48,4,0,0" ToolTip="Open ferryclip.app in your browser" AutomationProperties.Name="Open ferryclip.app in your browser"/></StackPanel></Border>
   </Grid>
   <Grid Grid.Column="1" Background="{StaticResource Surface}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Border x:Name="PageHeader" Margin="32,26,32,0"><TextBlock Text="{Binding Page}" MaxWidth="1000" HorizontalAlignment="Stretch" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24"/></Border><ContentControl x:Name="PageHost" Grid.Row="1" Margin="32,16,32,28" HorizontalAlignment="Stretch" MaxWidth="1000" Content="{Binding Navigation.Content}"></ContentControl><Border Grid.Row="1" VerticalAlignment="Top" Height="16" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1A1D21" Offset="0"/><GradientStop Color="#001A1D21" Offset="1"/></LinearGradientBrush></Border.Background></Border></Grid>
  </Grid>
  <Border Grid.RowSpan="2" Background="#CC111720" Visibility="{Binding DialogOpen,Converter={StaticResource BoolVisibility}}"><Border Style="{StaticResource Card}" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center"><StackPanel x:Name="DialogHost" KeyboardNavigation.TabNavigation="Cycle"><TextBlock Text="{Binding DialogTitle}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding DialogText}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,16,0,24"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><CheckBox Content="{Binding DialogOptionLabel}" IsChecked="{Binding DialogOptionChecked}" Visibility="{Binding ShowDialogOption,Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center" Margin="0,0,16,0"/><Button x:Name="CancelButton" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0"/><Button Content="Confirm" Command="{Binding ConfirmCommand}" Foreground="{StaticResource Danger}"/></StackPanel></StackPanel></Border></Border>
  <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Style="{StaticResource Card}" Margin="24" Visibility="{Binding HasToast,Converter={StaticResource BoolVisibility}}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Toast}" MaxWidth="420" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Content="×" Command="{Binding DismissToastCommand}" Style="{StaticResource IconButton}" Margin="16,0,0,0" ToolTip="Dismiss notification"/></StackPanel></Border>
 </Grid>
</Window>
