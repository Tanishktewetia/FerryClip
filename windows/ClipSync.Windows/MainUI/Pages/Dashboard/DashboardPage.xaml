<UserControl x:Class="ClipSync.Windows.MainUI.Pages.Dashboard.DashboardPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:components="clr-namespace:ClipSync.Windows.MainUI.Components">
 <UserControl.Resources>
  <ResourceDictionary>
   <Geometry x:Key="RevealEyeIcon">M 1,8 C 3,4 13,4 15,8 C 13,12 3,12 1,8 Z M 6,8 A 2,2 0 1 0 10,8 A 2,2 0 1 0 6,8</Geometry>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="../../Theme/Controls.xaml"/>
    <ResourceDictionary Source="../../Theme/Icons.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
  <StackPanel>
   <ContentControl Content="{Binding Status}" Margin="0,0,0,18">
    <ContentControl.ContentTemplate>
     <DataTemplate>
      <Border Background="{Binding Tint}" CornerRadius="10" Padding="16">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
         <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,12,0">
          <Ellipse.Style>
           <Style TargetType="Ellipse">
            <Setter Property="Fill" Value="{Binding Color}"/>
            <Style.Triggers><DataTrigger Binding="{Binding Title}" Value="Not connected"><Setter Property="Fill" Value="{StaticResource Danger}"/></DataTrigger></Style.Triggers>
           </Style>
          </Ellipse.Style>
         </Ellipse>
         <StackPanel>
          <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold">
           <TextBlock.Style>
            <Style TargetType="TextBlock">
             <Style.Triggers><DataTrigger Binding="{Binding Title}" Value="Not connected"><Setter Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger></Style.Triggers>
            </Style>
           </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
         </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Margin="16,0,0,0" Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" Visibility="{Binding HasAction,Converter={StaticResource BoolVisibility}}">
         <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource MainButton}">
           <Style.Triggers>
            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
             <Setter Property="Background" Value="{StaticResource Accent}"/>
             <Setter Property="Foreground" Value="#172334"/>
             <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </Button.Style>
        </Button>
       </Grid>
      </Border>
     </DataTemplate>
    </ContentControl.ContentTemplate>
   </ContentControl>
   <Grid x:Name="Columns" Margin="0,0,0,18">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <components:PairingPanel x:Name="Pairing" DataContext="{Binding Pairing}" VerticalAlignment="Stretch"/>
    <Border x:Name="DevicesCard" Grid.Column="2" Style="{StaticResource Card}">
     <StackPanel>
      <TextBlock Text="Your devices" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
      <ItemsControl ItemsSource="{Binding Devices}">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Path Data="{StaticResource DevicesIcon}" Stroke="{StaticResource Muted}" StrokeThickness="1.3" Width="18" Height="22" Stretch="Uniform" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Margin="8,0,10,0" VerticalAlignment="Center">
           <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0">
            <TextBlock.Style>
             <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{StaticResource Connected}"/>
              <Style.Triggers>
               <DataTrigger Binding="{Binding StatusResource}" Value="Paused"><Setter Property="Foreground" Value="{StaticResource Paused}"/></DataTrigger>
               <DataTrigger Binding="{Binding StatusResource}" Value="Unreachable"><Setter Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger>
              </Style.Triggers>
             </Style>
            </TextBlock.Style>
           </TextBlock>
           <TextBlock Text="{Binding LastSeen}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
          </StackPanel>
          <CheckBox Grid.Column="2" IsChecked="{Binding SyncEnabled,Mode=TwoWay}" VerticalAlignment="Center" ToolTip="Enable or pause sync for this device" AutomationProperties.Name="{Binding SyncAutomationName}"/>
         </Grid>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Visibility="{Binding NoDevices,Converter={StaticResource BoolVisibility}}" Margin="0,8,0,12">
       <TextBlock Text="No devices paired yet" FontWeight="SemiBold"/>
       <TextBlock Text="Generate a code and enter it on your phone to start syncing." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel>
     </StackPanel>
    </Border>
   </Grid>
   <Border Style="{StaticResource Card}">
    <StackPanel>
     <TextBlock Text="Recent clipboard" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <Border Background="{StaticResource Raised}" CornerRadius="6" Padding="12,10" Margin="0,0,0,12" Visibility="{Binding IsPaused,Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="Sync paused. New clips won't appear." Foreground="{StaticResource Paused}" TextWrapping="Wrap"/>
     </Border>
     <ItemsControl ItemsSource="{Binding Clips}" Opacity="{Binding HistoryOpacity}" Visibility="{Binding HasClips,Converter={StaticResource BoolVisibility}}">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Grid Margin="0,2,0,8">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="0">
          <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Preview}"/>
          <TextBlock Text="{Binding Time}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
         </StackPanel>
         <Border Grid.Column="1" Background="{StaticResource Raised}" CornerRadius="4" Padding="7,3" VerticalAlignment="Center" Margin="0,0,4,0">
          <TextBlock Text="{Binding Direction}" FontSize="12">
           <TextBlock.Style>
            <Style TargetType="TextBlock">
             <Setter Property="Foreground" Value="{StaticResource Accent}"/>
             <Style.Triggers><DataTrigger Binding="{Binding Direction}" Value="From phone"><Setter Property="Foreground" Value="{StaticResource Connected}"/></DataTrigger></Style.Triggers>
            </Style>
           </TextBlock.Style>
          </TextBlock>
         </Border>
         <Button Grid.Column="2" Style="{StaticResource IconButton}" Margin="2,0,0,0" Command="{Binding RevealCommand}" ToolTip="{Binding RevealLabel}" AutomationProperties.Name="{Binding RevealLabel}" Visibility="{Binding Sensitive,Converter={StaticResource BoolVisibility}}">
          <Path Data="{StaticResource RevealEyeIcon}" Stroke="{StaticResource Muted}" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform"/>
         </Button>
         <Button Grid.Column="3" Style="{StaticResource IconButton}" Command="{Binding CopyCommand}" ToolTip="Copy clip" AutomationProperties.Name="Copy clip" Margin="2,0,0,0">
          <Path Data="{StaticResource CopyIcon}" Stroke="{StaticResource Text}" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform"/>
         </Button>
        </Grid>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <StackPanel Visibility="{Binding ShowHistoryMessage,Converter={StaticResource BoolVisibility}}" Margin="0,8,0,16">
      <TextBlock Text="{Binding HistoryMessage}" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding HistoryHint}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <Button Content="Open Settings" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="{Binding HistoryOff,Converter={StaticResource BoolVisibility}}"/>
     </StackPanel>
     <Button Content="View all history" Command="{Binding ViewHistoryCommand}" HorizontalAlignment="Left" Foreground="{StaticResource Accent}" Background="Transparent" BorderBrush="Transparent" Padding="0,8"/>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
