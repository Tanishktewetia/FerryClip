<UserControl x:Class="ClipSync.Windows.MainUI.Pages.Dashboard.DashboardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dashboard="clr-namespace:ClipSync.Windows.MainUI.Pages.Dashboard">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Theme/Controls.xaml"/><ResourceDictionary Source="../../Theme/Icons.xaml"/></ResourceDictionary.MergedDictionaries>
  <dashboard:InverseBooleanToVisibilityConverter x:Key="InverseBoolVisibility"/>
  <Geometry x:Key="RevealEyeIcon">M1,8 C3,4 13,4 15,8 C13,12 3,12 1,8 Z M6,8 A2,2 0 1 0 10,8 A2,2 0 1 0 6,8</Geometry>
  <Geometry x:Key="PhoneDashboardIcon">M6,1 L14,1 Q16,1 16,3 L16,17 Q16,19 14,19 L6,19 Q4,19 4,17 L4,3 Q4,1 6,1 M8,16 L12,16</Geometry>
  <Geometry x:Key="PauseDashboardIcon">M5,3 L8,3 8,17 5,17 Z M12,3 L15,3 15,17 12,17 Z</Geometry>
  <Geometry x:Key="PlayDashboardIcon">M5,2 L17,10 5,18 Z</Geometry>
  <Geometry x:Key="CheckDashboardIcon">M2,9 L7,14 18,3</Geometry>
  <Geometry x:Key="CopyDashboardIcon">M7,3 L18,3 18,16 7,16 Z M4,7 L4,20 15,20</Geometry>
  <Geometry x:Key="ChevronDashboardIcon">M3,6 L9,12 15,6</Geometry>
  <Style x:Key="StatusActionButton" TargetType="Button" BasedOn="{StaticResource MainButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,8"/><Style.Triggers><DataTrigger Binding="{Binding IsPrimary}" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{StaticResource AccentText}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="DashboardRowButton" TargetType="Button" BasedOn="{StaticResource MainButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="HitSurface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HitSurface" Property="Background" Value="#182A2F36"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="HitSurface" Property="Background" Value="{StaticResource Raised}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="RecentEntryCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Raised}"/></Trigger></Style.Triggers></Style>
 </ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
  <StackPanel>
   <ContentControl Content="{Binding Status}" Margin="0,0,0,16"><ContentControl.ContentTemplate><DataTemplate><Border Background="{Binding Tint}" CornerRadius="10" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,12,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{Binding Color}"/><Style.Triggers><DataTrigger Binding="{Binding Title}" Value="Not connected"><Setter Property="Fill" Value="{StaticResource Danger}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><StackPanel><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Title}" Value="Not connected"><Setter Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></StackPanel><Button Grid.Column="1" Style="{StaticResource StatusActionButton}" Margin="16,0,0,0" Command="{Binding ActionCommand}" Visibility="{Binding HasAction,Converter={StaticResource BoolVisibility}}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource PauseDashboardIcon}" Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Margin="0,0,8,0"><Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsPrimary}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Path.Style></Path><Path Data="{StaticResource PlayDashboardIcon}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0" Visibility="{Binding IsPrimary,Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding ActionLabel}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="SemiBold"/></StackPanel></Button></Grid></Border></DataTemplate></ContentControl.ContentTemplate></ContentControl>
   <Grid x:Name="Columns" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="PairingCard" Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Stretch"><StackPanel><TextBlock Text="Pair a new device" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Create a one-time code to connect your phone" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,12"/><StackPanel Visibility="{Binding Pairing.Active,Converter={StaticResource BoolVisibility}}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Pairing.Code}" FontFamily="Consolas" FontSize="40" VerticalAlignment="Center"/><Button Content="Copy" Command="{Binding Pairing.CopyCommand}" Margin="12,0,0,0" ToolTip="Copy pairing code"/></StackPanel><TextBlock Text="{Binding Pairing.Countdown}" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/><Button Content="Regenerate" Command="{Binding Pairing.GenerateCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel><TextBlock Text="Last code expired" Foreground="{StaticResource Paused}" FontSize="13" Visibility="{Binding Pairing.Expired,Converter={StaticResource BoolVisibility}}" Margin="0,6,0,0"/><Button Content="Generate code" Command="{Binding Pairing.GenerateCommand}" Visibility="{Binding Pairing.Active,Converter={StaticResource InverseBoolVisibility}}" HorizontalAlignment="Left" Margin="0,14,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource MainButton}"><Style.Triggers><DataTrigger Binding="{Binding Pairing.IsPrimary}" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{StaticResource AccentText}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><TextBlock Text="Enter the code on your phone to start syncing." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="{Binding Pairing.Active,Converter={StaticResource BoolVisibility}}"/></StackPanel></Border>
    <Border x:Name="DevicesCard" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Stretch"><StackPanel><TextBlock Text="Your devices" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding Devices}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Style="{StaticResource DashboardRowButton}" Command="{Binding OpenCommand}" ToolTip="Open devices"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><Border Width="36" Height="36" Background="{StaticResource Raised}" CornerRadius="9" VerticalAlignment="Center"><Path Data="{StaticResource PhoneDashboardIcon}" Width="16" Height="21" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text=" · " Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding LastSeen}" ToolTip="{Binding FullTime}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel></StackPanel><Path Grid.Column="2" Data="{StaticResource ChevronDashboardIcon}" Width="11" Height="11" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center"><Path.RenderTransform><RotateTransform Angle="-90"/></Path.RenderTransform></Path></Grid></Button><CheckBox Grid.Column="1" IsChecked="{Binding SyncEnabled,Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Enable or pause sync for this device" AutomationProperties.Name="{Binding SyncAutomationName}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel Visibility="{Binding NoDevices,Converter={StaticResource BoolVisibility}}" Margin="0,4,0,0"><TextBlock Text="No devices paired yet" FontWeight="SemiBold"/><TextBlock Text="Generate a code and enter it on your phone to start syncing." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></StackPanel></Border>
   </Grid>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Recent clipboard" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><Border Background="{StaticResource Raised}" CornerRadius="6" Padding="12,9" Margin="0,0,0,10" Visibility="{Binding IsPaused,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Sync paused. New clips won't appear." Foreground="{StaticResource Paused}" TextWrapping="Wrap"/></Border>
    <ItemsControl ItemsSource="{Binding Clips}" Opacity="{Binding HistoryOpacity}" Visibility="{Binding HasClips,Converter={StaticResource BoolVisibility}}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource RecentEntryCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="0"><TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="38" LineHeight="18" TextTrimming="CharacterEllipsis" ToolTip="{Binding Preview}"/><TextBlock Text="{Binding Time}" ToolTip="{Binding FullTime}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel><Border Grid.Column="1" Background="{StaticResource Raised}" CornerRadius="4" Padding="7,3" VerticalAlignment="Center" Margin="0,0,5,0"><TextBlock Text="{Binding Direction}" FontSize="12" Foreground="{StaticResource Accent}"/></Border><Button Grid.Column="2" Style="{StaticResource IconButton}" Margin="2,0,0,0" Command="{Binding RevealCommand}" ToolTip="{Binding RevealLabel}" AutomationProperties.Name="{Binding RevealLabel}" Visibility="{Binding Sensitive,Converter={StaticResource BoolVisibility}}"><Path Data="{StaticResource RevealEyeIcon}" Stroke="{StaticResource Muted}" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform"/></Button><Button Grid.Column="3" Margin="2,0,0,0" Command="{Binding CopyCommand}" ToolTip="{Binding CopyToolTip}" AutomationProperties.Name="{Binding CopyToolTip}" Cursor="Hand"><Grid><Path Data="{StaticResource CopyDashboardIcon}" Stroke="{StaticResource Text}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform"><Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsCopied}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Path.Style></Path><Path Data="{StaticResource CheckDashboardIcon}" Stroke="{StaticResource Connected}" StrokeThickness="2" Width="16" Height="16" Stretch="Uniform" Visibility="Collapsed"><Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsCopied}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Grid><Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"/></Button.Style></Button></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <StackPanel Visibility="{Binding ShowHistoryMessage,Converter={StaticResource BoolVisibility}}" Margin="0,6,0,10"><TextBlock Text="{Binding HistoryMessage}" FontWeight="SemiBold"/><TextBlock Text="{Binding HistoryHint}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/><Button Content="Turn on" Command="{Binding TurnOnHistoryCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="{Binding HistoryOff,Converter={StaticResource BoolVisibility}}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource MainButton}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{StaticResource AccentText}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Style></Button.Style></Button></StackPanel>
    <Button Command="{Binding ViewHistoryCommand}" HorizontalAlignment="Left" Foreground="{StaticResource Muted}" Background="Transparent" BorderBrush="Transparent" Padding="0,7" Cursor="Hand"><StackPanel Orientation="Horizontal"><TextBlock Text="View all history" VerticalAlignment="Center"/><Path Data="{StaticResource ChevronDashboardIcon}" Width="10" Height="10" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.5" Margin="7,0,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform Angle="-90"/></Path.RenderTransform></Path></StackPanel></Button>
   </StackPanel></Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
