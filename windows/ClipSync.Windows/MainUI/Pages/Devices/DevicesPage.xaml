<UserControl x:Class="ClipSync.Windows.MainUI.Pages.Devices.DevicesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:ClipSync.Windows.MainUI.Components">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Theme/Controls.xaml"/><ResourceDictionary Source="../../Theme/Icons.xaml"/></ResourceDictionary.MergedDictionaries>
  <Geometry x:Key="PhoneDeviceIcon">M6,1 L14,1 Q16,1 16,3 L16,17 Q16,19 14,19 L6,19 Q4,19 4,17 L4,3 Q4,1 6,1 M8,16 L12,16</Geometry>
  <Geometry x:Key="RenameDeviceIcon">M3,14 L2,18 6,17 17,6 14,3 Z M12,5 L15,8</Geometry>
  <Geometry x:Key="ForgetDeviceIcon">M3,5 L17,5 M7,3 L13,3 M5,5 L6,18 14,18 15,5 M8,8 L8,15 M12,8 L12,15</Geometry>
  <Geometry x:Key="MoreDeviceIcon">M4,10 A1.5,1.5 0 1 0 7,10 A1.5,1.5 0 1 0 4,10 M9,10 A1.5,1.5 0 1 0 12,10 A1.5,1.5 0 1 0 9,10 M14,10 A1.5,1.5 0 1 0 17,10 A1.5,1.5 0 1 0 14,10</Geometry>
  <Geometry x:Key="AddDeviceIcon">M10,2 L10,18 M2,10 L18,10</Geometry>
  <Style x:Key="DeviceMenu" TargetType="ContextMenu"><Setter Property="Background" Value="{StaticResource CardSurface}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Padding" Value="6"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="DeviceMenuItem" TargetType="MenuItem"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Padding" Value="10,8"/><Setter Property="MinWidth" Value="170"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="Row" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><Path Data="{Binding Tag,RelativeSource={RelativeSource TemplatedParent}}" Width="15" Height="15" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" VerticalAlignment="Center"/><ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Raised}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ForgetMenuItem" TargetType="MenuItem" BasedOn="{StaticResource DeviceMenuItem}"><Setter Property="Foreground" Value="{StaticResource Danger}"/></Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <ItemsControl ItemsSource="{Binding Devices}"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16"><StackPanel>
      <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Width="40" Height="40" Background="{StaticResource Raised}" CornerRadius="10" VerticalAlignment="Center"><Path Data="{StaticResource PhoneDeviceIcon}" Width="17" Height="23" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Visibility="{Binding IsNotEditing,Converter={StaticResource BoolVisibility}}"/>
        <TextBox Text="{Binding DraftName,UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Style="{StaticResource MainTextBox}" Loaded="RenameLoaded" LostKeyboardFocus="RenameLostFocus" Visibility="{Binding IsEditing,Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Device name"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SaveRenameCommand}"/><KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}"/></TextBox.InputBindings></TextBox>
        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Visibility="{Binding HasError,Converter={StaticResource BoolVisibility}}"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="{Binding Subtitle}" ToolTip="{Binding FullTime}" Foreground="{Binding StatusBrush}" FontSize="13" FontWeight="SemiBold"/></StackPanel>
       </StackPanel>
       <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Sync" VerticalAlignment="Center" Margin="0,0,8,0"/><CheckBox IsChecked="{Binding SyncEnabled,Mode=TwoWay}" AutomationProperties.Name="{Binding Name,StringFormat=Sync with {0}}"/></StackPanel>
       <Button Grid.Column="3" Style="{StaticResource IconButton}" Margin="12,0,0,0" VerticalAlignment="Center" Click="OpenOverflow" ToolTip="Device actions" AutomationProperties.Name="Device actions"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse Width="3.5" Height="3.5" Fill="{StaticResource Text}" Margin="1.5,0"/><Ellipse Width="3.5" Height="3.5" Fill="{StaticResource Text}" Margin="1.5,0"/><Ellipse Width="3.5" Height="3.5" Fill="{StaticResource Text}" Margin="1.5,0"/></StackPanel><Button.ContextMenu><ContextMenu Style="{StaticResource DeviceMenu}"><MenuItem Header="Rename" Tag="{StaticResource RenameDeviceIcon}" Style="{StaticResource DeviceMenuItem}" Command="{Binding RenameCommand}"/><MenuItem Header="Forget device" Tag="{StaticResource ForgetDeviceIcon}" Style="{StaticResource ForgetMenuItem}" Command="{Binding ForgetCommand}"/></ContextMenu></Button.ContextMenu></Button>
      </Grid>
      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,16,0,0"><StackPanel>
       <TextBlock Text="Connection details" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
       <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel Margin="12"><TextBlock Text="IP address" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding Address}" Margin="0,4,0,0"/></StackPanel>
        <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,1,0"><StackPanel Margin="12"><TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding TimeValue}" ToolTip="{Binding FullTime}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
        <StackPanel Grid.Column="2" Margin="12"><TextBlock Text="Network" Foreground="{StaticResource Muted}" FontSize="12"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><Path Data="M0,6 Q8,-2 16,6 M3,9 Q8,3 13,9 M6,12 Q8,9 10,12" Stroke="{StaticResource Muted}" StrokeThickness="1.4" Width="16" Height="14" Margin="0,0,8,0"/><TextBlock Text="{Binding Network}"/></StackPanel></StackPanel>
       </Grid></Border>
      </StackPanel></Border>
     </StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <StackPanel Visibility="{Binding HasDevices,Converter={StaticResource BoolVisibility}}">
     <TextBlock Text="Replacing your phone? Forget the old device, then pair your new phone." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>
     <Border Margin="0,0,0,16" Padding="20" CornerRadius="12"><Grid><Rectangle Stroke="{StaticResource Line}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="12" RadiusY="12"/><Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource Raised}" VerticalAlignment="Center"><Path Data="{StaticResource AddDeviceIcon}" Width="15" Height="15" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.8"/></Border><TextBlock Grid.Column="1" Text="Link another phone to start syncing" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,12,0" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" Content="Add device" Command="{Binding AddCommand}" Padding="14,7" Margin="0,0,6,0"/></Grid></Grid></Border>
    </StackPanel>
    <Border Style="{StaticResource Card}" Padding="20" Visibility="{Binding IsEmpty,Converter={StaticResource BoolVisibility}}"><StackPanel>
     <TextBlock Text="Pair your first device" FontSize="20" FontWeight="SemiBold"/>
     <StackPanel Margin="0,14,0,16"><TextBlock Text="1   Open FerryClip on your phone" Margin="0,0,0,9"/><TextBlock Text="2   Tap Add a PC" Margin="0,0,0,9"/><TextBlock Text="3   Enter the six-digit code"/></StackPanel>
     <components:PairingPanel DataContext="{Binding Pairing}"/>
    </StackPanel></Border>
   </StackPanel>
  </ScrollViewer>
  <Border Background="#E61A1D21" Visibility="{Binding PairingOpen,Converter={StaticResource BoolVisibility}}">
   <Border Style="{StaticResource Card}" MaxWidth="440" Margin="20" VerticalAlignment="Center"><StackPanel x:Name="PairingDialog" KeyboardNavigation.TabNavigation="Cycle"><components:PairingPanel DataContext="{Binding Pairing}"/><Button x:Name="ClosePairing" Content="Close" Command="{Binding ClosePairingCommand}" HorizontalAlignment="Right" Margin="0,16,0,0"/></StackPanel></Border>
  </Border>
 </Grid>
</UserControl>
