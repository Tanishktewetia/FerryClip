<UserControl x:Class="ClipSync.Windows.MainUI.Pages.Devices.DevicesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:ClipSync.Windows.MainUI.Components">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Theme/Controls.xaml"/><ResourceDictionary Source="../../Theme/Icons.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <ItemsControl ItemsSource="{Binding Devices}"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
      <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Path Data="M 4,1 L 16,1 16,23 4,23 Z M 9,20 L 11,20" Stroke="{StaticResource Text}" StrokeThickness="1.4" Width="17" Height="25" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"/>
       <StackPanel Grid.Column="1" Margin="0,0,12,0">
        <TextBlock Text="{Binding Name}" FontSize="17" TextTrimming="CharacterEllipsis" Visibility="{Binding IsNotEditing,Converter={StaticResource BoolVisibility}}"/>
        <TextBox Text="{Binding DraftName,UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Style="{StaticResource MainTextBox}" Loaded="RenameLoaded" Visibility="{Binding IsEditing,Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Device name"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SaveRenameCommand}"/><KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}"/></TextBox.InputBindings></TextBox>
        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Visibility="{Binding HasError,Converter={StaticResource BoolVisibility}}"/>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="13"/></StackPanel>
       </StackPanel>
       <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Sync" VerticalAlignment="Center" Margin="0,0,8,0"/><CheckBox IsChecked="{Binding SyncEnabled,Mode=TwoWay}" AutomationProperties.Name="{Binding Name,StringFormat=Sync with {0}}"/></StackPanel>
       <Button Grid.Column="3" Content="&#xE712;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButton}" Margin="12,0,0,0" VerticalAlignment="Center" Click="OpenOverflow" ToolTip="Device actions" AutomationProperties.Name="Device actions"><Button.ContextMenu><ContextMenu><MenuItem Header="Rename" Command="{Binding RenameCommand}"/><MenuItem Header="Forget device" Foreground="{StaticResource Danger}" Command="{Binding ForgetCommand}"/></ContextMenu></Button.ContextMenu></Button>
      </Grid>
      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,18,0,0"><StackPanel>
       <TextBlock Text="Connection details" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
       <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel Margin="12"><TextBlock Text="IP address" Foreground="{StaticResource Muted}" FontSize="13"/><TextBlock Text="{Binding Address}" Margin="0,4,0,0"/></StackPanel>
        <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,1,0"><StackPanel Margin="12"><TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource Muted}" FontSize="13"/><TextBlock Text="{Binding TimeValue}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
        <StackPanel Grid.Column="2" Margin="12"><TextBlock Text="Network" Foreground="{StaticResource Muted}" FontSize="13"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><Path Data="M0,6 Q8,-2 16,6 M3,9 Q8,3 13,9 M6,12 Q8,9 10,12" Stroke="{StaticResource Muted}" StrokeThickness="1.4" Width="16" Height="14" Margin="0,0,8,0"/><TextBlock Text="{Binding Network}"/></StackPanel></StackPanel>
       </Grid></Border>
      </StackPanel></Border>
     </StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <StackPanel Visibility="{Binding HasDevices,Converter={StaticResource BoolVisibility}}">
     <TextBlock Text="Replacing your phone? Forget the old device, then pair your new phone." Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,18"/>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Pair another device" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,12,0,4"/><TextBlock Text="Link a new phone to start syncing" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,16"/><Button Content="Add device" Command="{Binding AddCommand}" Style="{StaticResource MainButton}" Width="160" HorizontalAlignment="Center"/></StackPanel></Border>
    </StackPanel>
    <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty,Converter={StaticResource BoolVisibility}}"><StackPanel>
     <TextBlock Text="Pair your first device" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Keep your clipboard in sync with your phone." Foreground="{StaticResource Muted}" Margin="0,8,0,20"/>
     <TextBlock Text="1. Open FerryClip on your phone." Margin="0,0,0,10"/><TextBlock Text="2. Generate a pairing code below." Margin="0,0,0,10"/><TextBlock Text="3. Enter the code on your phone to connect." Margin="0,0,0,20"/>
     <components:PairingPanel DataContext="{Binding Pairing}"/>
    </StackPanel></Border>
   </StackPanel>
  </ScrollViewer>
  <Border Background="#E61A1D21" Visibility="{Binding PairingOpen,Converter={StaticResource BoolVisibility}}">
   <Border Style="{StaticResource Card}" MaxWidth="440" Margin="20" VerticalAlignment="Center"><StackPanel x:Name="PairingDialog" KeyboardNavigation.TabNavigation="Cycle"><components:PairingPanel DataContext="{Binding Pairing}"/><Button x:Name="ClosePairing" Content="Close" Command="{Binding ClosePairingCommand}" HorizontalAlignment="Right" Margin="0,16,0,0"/></StackPanel></Border>
  </Border>
 </Grid>
</UserControl>
