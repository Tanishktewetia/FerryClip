<UserControl x:Class="ClipSync.Windows.MainUI.Pages.HelpAbout.AboutPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent" SizeChanged="AboutPage_SizeChanged">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/FerryClip;component/MainUI/Theme/Controls.xaml"/><ResourceDictionary Source="/FerryClip;component/MainUI/Theme/Icons.xaml"/></ResourceDictionary.MergedDictionaries>
  <Geometry x:Key="ExternalLinkIcon">M5,5 L2,5 2,18 15,18 15,15 M9,2 L18,2 18,11 M18,2 L8,12</Geometry>
  <Geometry x:Key="ShieldRowIcon">M10,1 L18,4 17,11 Q16,17 10,20 Q4,17 3,11 L2,4 Z M6,10 L9,13 14,8</Geometry>
  <Geometry x:Key="DocumentAboutIcon">M4,2 L13,2 18,7 18,20 4,20 Z M13,2 L13,7 18,7 M7,11 L15,11 M7,14 L15,14 M7,17 L13,17</Geometry>
  <Geometry x:Key="CopyAboutIcon">M7,4 L18,4 18,18 7,18 Z M4,7 L4,20 15,20</Geometry>
  <Style x:Key="AboutIconButton" TargetType="Button" BasedOn="{StaticResource MainButton}"><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  <Style x:Key="LegalRowButton" TargetType="Button" BasedOn="{StaticResource MainButton}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="52"/></Style>
 </ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel x:Name="AboutContent">
   <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
    <Grid x:Name="HeroLayout"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Image Source="/FerryClip;component/Assets/ferryclip_logo.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" Margin="0,0,16,0"/>
     <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="FerryClip" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{Binding VersionLabel}" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/><TextBlock Text="{Binding Tagline}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,12,0"/></StackPanel>
     <StackPanel x:Name="AboutLinks" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource AboutIconButton}" Command="{Binding WebsiteCommand}" ToolTip="Open FerryClip website"><StackPanel Orientation="Horizontal"><TextBlock Text="Website"/><Path Data="{StaticResource ExternalLinkIcon}" Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.5" Margin="7,0,0,0"/></StackPanel></Button><Button Style="{StaticResource AboutIconButton}" Command="{Binding GitHubCommand}" ToolTip="Open GitHub"><StackPanel Orientation="Horizontal"><TextBlock Text="GitHub"/><Path Data="{StaticResource ExternalLinkIcon}" Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.5" Margin="7,0,0,0"/></StackPanel></Button><Button Style="{StaticResource AboutIconButton}" Command="{Binding ReleasesCommand}" Margin="0" ToolTip="Open release notes"><StackPanel Orientation="Horizontal"><TextBlock Text="Release notes"/><Path Data="{StaticResource ExternalLinkIcon}" Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.5" Margin="7,0,0,0"/></StackPanel></Button></StackPanel>
    </Grid>
   </Border>
   <TextBlock Text="Private by design" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <ItemsControl x:Name="FeatureTiles" Margin="0,0,0,16" ItemsSource="{Binding Features}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Path Data="{Binding Icon}" Width="22" Height="22" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.7" HorizontalAlignment="Left" Margin="0,0,0,10"/><TextBlock Grid.Row="1" Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBlock Grid.Row="2" Text="{Binding Description}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12"><StackPanel>
    <TextBlock Text="Legal &amp; info" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <Button Style="{StaticResource LegalRowButton}" Visibility="{Binding LicenseAvailable,Converter={StaticResource BoolVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource AboutIcon}" Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.5"/><StackPanel Grid.Column="1"><TextBlock Text="License" FontWeight="SemiBold"/><TextBlock Text="{Binding LicenseName}" Foreground="{StaticResource Muted}" FontSize="13"/></StackPanel><Path Grid.Column="2" Data="{StaticResource ExternalLinkIcon}" Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.5"/></Grid></Button>
    <Button Style="{StaticResource LegalRowButton}" Command="{Binding ShowNoticesCommand}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource DocumentAboutIcon}" Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.5"/><StackPanel Grid.Column="1"><TextBlock Text="Third-party notices" FontWeight="SemiBold"/><TextBlock Text="View notices for bundled dependencies" Foreground="{StaticResource Muted}" FontSize="13"/></StackPanel><TextBlock Grid.Column="2" Text="›" FontSize="22" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Grid></Button>
    <Button Style="{StaticResource LegalRowButton}" Command="{Binding PrivacyCommand}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource ShieldRowIcon}" Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.5"/><StackPanel Grid.Column="1"><TextBlock Text="Privacy" FontWeight="SemiBold"/><TextBlock Text="How FerryClip handles clipboard data" Foreground="{StaticResource Muted}" FontSize="13"/></StackPanel><Path Grid.Column="2" Data="{StaticResource ExternalLinkIcon}" Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.5"/></Grid></Button>
    <Button Style="{StaticResource LegalRowButton}" Command="{Binding CopyAppInfoCommand}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource CopyAboutIcon}" Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.5"/><StackPanel Grid.Column="1"><TextBlock Text="Copy app info" FontWeight="SemiBold"/><TextBlock Text="Version, Windows version and connection state only" Foreground="{StaticResource Muted}" FontSize="13"/></StackPanel><TextBlock Grid.Column="2" Text="Copy" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/></Grid></Button>
    <Border Visibility="{Binding ShowingNotices,Converter={StaticResource BoolVisibility}}" Background="{StaticResource Raised}" CornerRadius="8" Padding="14" Margin="0,8,0,0"><StackPanel><DockPanel><TextBlock Text="Third-party notices" FontWeight="SemiBold" DockPanel.Dock="Left"/><Button Content="Done" Command="{Binding ShowNoticesCommand}" HorizontalAlignment="Right" Padding="10,4" MinHeight="28"/></DockPanel><TextBlock Text="{Binding ThirdPartyNotices}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
   </StackPanel></Border>
   <TextBlock Text="{Binding CopyrightText}" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
