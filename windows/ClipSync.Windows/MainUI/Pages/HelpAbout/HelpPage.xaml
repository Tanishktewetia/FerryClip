<UserControl x:Class="ClipSync.Windows.MainUI.Pages.HelpAbout.HelpPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ClipSync.Windows.MainUI.Pages.HelpAbout" Background="Transparent">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/FerryClip;component/MainUI/Theme/Controls.xaml"/></ResourceDictionary.MergedDictionaries>
  <Geometry x:Key="ExternalHelpIcon">M5,5 L2,5 2,18 15,18 15,15 M9,2 L18,2 18,11 M18,2 L8,12</Geometry>
  <Geometry x:Key="GlobeHelpIcon">M10,1 A9,9 0 1 0 10,19 A9,9 0 1 0 10,1 M1,10 L19,10 M10,1 C5,5 5,15 10,19 M10,1 C15,5 15,15 10,19</Geometry>
  <Style x:Key="HeaderLink" TargetType="Button" BasedOn="{StaticResource MainButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  <Style x:Key="GuideCard" TargetType="Button" BasedOn="{StaticResource MainButton}"><Setter Property="Background" Value="{StaticResource CardSurface}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource CardRadius}" Padding="14"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{StaticResource Raised}"/><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Card" Property="RenderTransform"><Setter.Value><TranslateTransform Y="-2"/></Setter.Value></Setter></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Card" Property="Opacity" Value="0.82"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
  <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Help &amp; Docs" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource HeaderLink}" Command="{Binding WelcomeGuideCommand}" Content="Show welcome guide again"/><Button Style="{StaticResource HeaderLink}" Command="{Binding WebsiteCommand}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource GlobeHelpIcon}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.5" Margin="0,0,7,0"/><TextBlock Text="ferryclip.app"/></StackPanel></Button><Button Style="{StaticResource HeaderLink}" Margin="0" Command="{Binding GitHubCommand}"><StackPanel Orientation="Horizontal"><TextBlock Text="GitHub"/><Path Data="{StaticResource ExternalHelpIcon}" Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.5" Margin="7,0,0,0"/></StackPanel></Button></StackPanel></Grid>
  <Border x:Name="TroubleCard" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource Line}" BorderThickness="1"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource CardSurface}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Style.Triggers><DataTrigger Binding="{Binding IsWarning}" Value="True"><Setter Property="Background" Value="#14FF8A8A"/><Setter Property="BorderBrush" Value="#55FF8A8A"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid>
   <Button x:Name="TroubleSummaryButton" Command="{Binding TroubleCommand}" Background="Transparent" BorderBrush="Transparent" Padding="0" HorizontalContentAlignment="Stretch" Visibility="{Binding TroubleCollapsed,Converter={StaticResource BoolVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Connected. Need help anyway?" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="⌄" Foreground="{StaticResource Muted}" Margin="10,0,0,0"/></Grid></Button>
   <StackPanel x:Name="TroubleExpandedPanel" Visibility="{Binding TroubleDetailsVisible,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Having trouble connecting?" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Not connected right now. Try these steps." Foreground="{StaticResource Danger}" Margin="0,5,0,10" Visibility="{Binding IsWarning,Converter={StaticResource BoolVisibility}}"/><ItemsControl x:Name="TroubleSteps" ItemsSource="{Binding TroubleshootingSteps}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid x:Name="TroubleUniformGrid" Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4,14,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="{Binding Icon}" Width="19" Height="19" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.5" Margin="0,0,9,0"/><Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Raised}" VerticalAlignment="Center"><TextBlock Text="{Binding Number}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="28,6,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
  </Grid></Border>
  <TextBlock Text="Guides" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <ItemsControl x:Name="GuideGrid" ItemsSource="{Binding Resources}" Margin="0,0,0,16"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" Rows="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource GuideCard}" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Title}" Margin="0,0,12,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Raised}" VerticalAlignment="Top"><Path Data="{Binding Icon}" Width="21" Height="21" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,5,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" MaxHeight="34" Margin="0,5,0,0"/></StackPanel><Path Grid.Column="2" Data="{StaticResource ExternalHelpIcon}" Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.4" VerticalAlignment="Top"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Still stuck?" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Share an issue or copy safe diagnostic details." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,10,0"/></StackPanel><Button Grid.Column="1" Content="Report a problem" Command="{Binding ReportCommand}" Margin="8,0,8,0"/><Button Grid.Column="2" Content="Copy app info" Command="{Binding CopyAppInfoCommand}"/></Grid></Border>
  <TextBlock Text="{Binding Footer}" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,2,0,4"/>
 </StackPanel></ScrollViewer>
</UserControl>
