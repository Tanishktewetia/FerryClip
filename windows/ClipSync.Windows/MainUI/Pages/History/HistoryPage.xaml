<UserControl x:Class="ClipSync.Windows.MainUI.Pages.History.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ClipSync.Windows.MainUI.Pages.History" xmlns:infra="clr-namespace:ClipSync.Windows.MainUI.Infrastructure">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Theme/Controls.xaml"/><ResourceDictionary Source="../../Theme/Icons.xaml"/></ResourceDictionary.MergedDictionaries>
  <local:ExpandedChevronTransformConverter x:Key="ExpandedChevronTransformConverter"/><Geometry x:Key="ExpandChevron">M3,6 L9,12 15,6</Geometry><Geometry x:Key="HistoryCopyIcon">M7,3 L18,3 18,16 7,16 Z M4,7 L4,20 15,20</Geometry><Geometry x:Key="HistoryCheckIcon">M2,9 L7,14 18,3</Geometry><Geometry x:Key="HistoryPinIcon">M6,2 L14,2 13,8 17,12 3,12 7,8 Z M10,12 L10,20</Geometry>
  <Style x:Key="HistoryActionButton" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Opacity" Value="0.38"/><Setter Property="Margin" Value="1,0"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType=Border}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger><DataTrigger Binding="{Binding IsKeyboardFocusWithin,RelativeSource={RelativeSource AncestorType=Border}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="HistoryDeleteButton" TargetType="Button" BasedOn="{StaticResource HistoryActionButton}"><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType=Border}}" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger><DataTrigger Binding="{Binding IsKeyboardFocusWithin,RelativeSource={RelativeSource AncestorType=Border}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers></Style>
  <DataTemplate DataType="{x:Type local:HistoryHeading}"><Border Background="{StaticResource Surface}" Padding="0,8" Margin="0,4,0,4"><TextBlock Text="{Binding Title}" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/></Border></DataTemplate>
  <DataTemplate DataType="{x:Type local:HistoryClipViewModel}"><Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8" Cursor="Hand">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
     <Button Command="{Binding ExpandCommand}" HorizontalContentAlignment="Stretch" Background="Transparent" BorderBrush="Transparent" Padding="0" Cursor="Hand" ToolTip="{Binding ExpandLabel}" AutomationProperties.Name="{Binding ExpandLabel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="38" LineHeight="18" TextTrimming="CharacterEllipsis" Loaded="PreviewMeasure" SizeChanged="PreviewMeasure"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Expanded}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Path Grid.Column="1" Data="{StaticResource ExpandChevron}" Width="12" Height="8" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.6" VerticalAlignment="Center" Visibility="{Binding CanExpand,Converter={StaticResource BoolVisibility}}"><Path.RenderTransform><RotateTransform Angle="{Binding Expanded,Converter={StaticResource ExpandedChevronTransformConverter}}"/></Path.RenderTransform></Path></Grid></Button>
     <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding Expanded,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding ExpandedText}" TextWrapping="Wrap"/></ScrollViewer>
     <TextBlock Text="{Binding Metadata}" ToolTip="{Binding FullTime}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Border CornerRadius="4" Padding="7,4" VerticalAlignment="Center" Margin="0,0,4,0"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#293D52"/><Style.Triggers><DataTrigger Binding="{Binding FromPhone}" Value="True"><Setter Property="Background" Value="#234B4C"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Direction}" FontSize="12" Foreground="{StaticResource Accent}"/></Border>
     <Button Style="{StaticResource HistoryActionButton}" Command="{Binding RevealCommand}" Visibility="{Binding Sensitive,Converter={StaticResource BoolVisibility}}" ToolTip="{Binding RevealLabel}" AutomationProperties.Name="{Binding RevealLabel}"><Path Data="M1,10 Q10,-1 19,10 Q10,21 1,10 M7,10 A3,3 0 1 0 13,10 A3,3 0 1 0 7,10" Width="17" Height="16" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/></Button>
     <Button Style="{StaticResource IconButton}" Command="{Binding CopyCommand}" ToolTip="{Binding CopyToolTip}" AutomationProperties.Name="{Binding CopyToolTip}" Cursor="Hand"><Grid><Path Data="{StaticResource HistoryCopyIcon}" Width="16" Height="17" Stretch="Uniform" Stroke="{StaticResource Text}" StrokeThickness="1.5"><Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsCopied}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Path.Style></Path><Path Data="{StaticResource HistoryCheckIcon}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Connected}" StrokeThickness="2" Visibility="Collapsed"><Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsCopied}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Grid></Button>
     <Button Style="{StaticResource HistoryActionButton}" Command="{Binding PinCommand}" ToolTip="{Binding PinLabel}" AutomationProperties.Name="{Binding PinLabel}"><Path Data="{StaticResource HistoryPinIcon}" Width="15" Height="17" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.5"><Path.Style><Style TargetType="Path"><Setter Property="Fill" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding Pinned}" Value="True"><Setter Property="Fill" Value="{StaticResource Accent}"/><Setter Property="Stroke" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Button>
     <Button Style="{StaticResource HistoryDeleteButton}" Command="{Binding DeleteCommand}" ToolTip="Delete clip (undo available)" AutomationProperties.Name="Delete clip"><Path Data="{StaticResource DeleteIcon}" Width="15" Height="17" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/></Button>
    </StackPanel>
   </Grid>
  </Border></DataTemplate>
 </ResourceDictionary></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid Margin="0,0,8,0"><TextBox x:Name="SearchBox" Style="{StaticResource MainTextBox}" Height="42" Padding="12,2" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search clipboard history"/><TextBlock Text="Search clipboard…  Ctrl+F" Foreground="{StaticResource Muted}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Command="{Binding AllCommand}" Content="All" Margin="0,0,5,0" Padding="10,7"><Button.ContentTemplate><DataTemplate><TextBlock><Run Text="All ("/><Run Text="{Binding DataContext.AllCount,RelativeSource={RelativeSource AncestorType=UserControl},Mode=OneWay}"/><Run Text=")"/></TextBlock></DataTemplate></Button.ContentTemplate><Button.Style><Style TargetType="Button" BasedOn="{StaticResource MainButton}"><Style.Triggers><DataTrigger Binding="{Binding AllSelected}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Command="{Binding PcCommand}" Margin="0,0,5,0" Padding="10,7"><Button.ContentTemplate><DataTemplate><TextBlock><Run Text="From PC ("/><Run Text="{Binding DataContext.PcCount,RelativeSource={RelativeSource AncestorType=UserControl},Mode=OneWay}"/><Run Text=")"/></TextBlock></DataTemplate></Button.ContentTemplate></Button><Button Command="{Binding PhoneCommand}" Padding="10,7"><Button.ContentTemplate><DataTemplate><TextBlock><Run Text="From phone ("/><Run Text="{Binding DataContext.PhoneCount,RelativeSource={RelativeSource AncestorType=UserControl},Mode=OneWay}"/><Run Text=")"/></TextBlock></DataTemplate></Button.ContentTemplate></Button></StackPanel>
  </Grid>
  <StackPanel Grid.Row="1"><DockPanel Visibility="{Binding IsPaused,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Resume sync" Command="{Binding ResumeCommand}"/><TextBlock Text="Sync is paused. Saved clips are still available." Foreground="{StaticResource Paused}" VerticalAlignment="Center"/></DockPanel><DockPanel Visibility="{Binding IsOff,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Turn on history" Command="{Binding EnableCommand}"/><TextBlock Text="History is off. New clips won’t be saved." Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel></StackPanel>
  <Grid Grid.Row="2"><ListBox x:Name="HistoryList" ItemsSource="{Binding Items}" Visibility="{Binding HasRows,Converter={StaticResource BoolVisibility}}" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"><ListBox.Resources><Style TargetType="ScrollViewer"><Setter Property="infra:OverlayScrollBehavior.Enabled" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer"><Grid><ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/><ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Width="7" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset,RelativeSource={RelativeSource TemplatedParent},Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/><ScrollBar x:Name="PART_HorizontalScrollBar" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{Binding HorizontalOffset,RelativeSource={RelativeSource TemplatedParent},Mode=OneWay}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/></Grid></ControlTemplate></Setter.Value></Setter></Style><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="True"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#0F2A2F36"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.Resources></ListBox><StackPanel Visibility="{Binding ShowEmpty,Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"><TextBlock Text="{Binding EmptyTitle}" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/></StackPanel><Border Height="16" VerticalAlignment="Top" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF1A1D21" Offset="0"/><GradientStop Color="#001A1D21" Offset="1"/></LinearGradientBrush></Border.Background></Border><Border Height="16" VerticalAlignment="Bottom" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#001A1D21" Offset="0"/><GradientStop Color="#FF1A1D21" Offset="1"/></LinearGradientBrush></Border.Background></Border><Border x:Name="StickyHeader" VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="{StaticResource Surface}" Padding="0,5" Visibility="Collapsed" IsHitTestVisible="False"><TextBlock Text="{Binding StickyGroup}" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/></Border></Grid>
  <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,10,0,0"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Clear history" Command="{Binding ClearCommand}" IsEnabled="{Binding CanClear}" Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource Danger}" Padding="8,5"/></StackPanel><TextBlock Text="{Binding CountText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,7" Margin="14,0,0,0" Visibility="{Binding UndoVisible,Converter={StaticResource BoolVisibility}}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,9,0"/><TextBlock Text="{Binding UndoText}" VerticalAlignment="Center" Foreground="{StaticResource Text}" Margin="0,0,12,0"/><Button Content="Undo" Command="{Binding UndoCommand}" Padding="12,5" MinHeight="30"/></StackPanel></Border></DockPanel></Border>
 </Grid>
</UserControl>
