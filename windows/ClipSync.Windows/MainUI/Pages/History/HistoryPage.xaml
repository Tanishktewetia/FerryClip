<UserControl x:Class="ClipSync.Windows.MainUI.Pages.History.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ClipSync.Windows.MainUI.Pages.History">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Theme/Controls.xaml"/><ResourceDictionary Source="../../Theme/Icons.xaml"/></ResourceDictionary.MergedDictionaries>
 <Style x:Key="RowIcon" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="2,0"/></Style>
 <Style x:Key="DeleteAction" TargetType="Button" BasedOn="{StaticResource RowIcon}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Danger}"/></Trigger></Style.Triggers></Style>
 <DataTemplate DataType="{x:Type local:HistoryHeading}"><TextBlock Text="{Binding Title}" Foreground="{StaticResource Muted}" FontWeight="SemiBold" Margin="0,12,0,8"/></DataTemplate>
 <DataTemplate DataType="{x:Type local:HistoryClipViewModel}">
  <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
     <Button Command="{Binding ExpandCommand}" HorizontalContentAlignment="Stretch" Background="Transparent" BorderBrush="Transparent" Padding="0" ToolTip="{Binding ExpandLabel}" AutomationProperties.Name="{Binding ExpandLabel}">
      <TextBlock Text="{Binding Preview}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextWrapping" Value="NoWrap"/><Style.Triggers><DataTrigger Binding="{Binding Expanded}" Value="True"><Setter Property="TextWrapping" Value="Wrap"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Button>
     <TextBlock Text="{Binding Metadata}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
     <Border CornerRadius="4" Padding="7,4" VerticalAlignment="Center" Margin="0,0,8,0"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#293D52"/><Style.Triggers><DataTrigger Binding="{Binding FromPhone}" Value="True"><Setter Property="Background" Value="#234B4C"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Direction}" FontSize="12" Foreground="{StaticResource Accent}"/></Border>
     <Button Style="{StaticResource RowIcon}" Command="{Binding RevealCommand}" Visibility="{Binding Sensitive,Converter={StaticResource BoolVisibility}}" ToolTip="{Binding RevealLabel}" AutomationProperties.Name="{Binding RevealLabel}"><Path Data="M1,10 Q10,-1 19,10 Q10,21 1,10 M7,10 A3,3 0 1 0 13,10 A3,3 0 1 0 7,10" Width="18" Height="16" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/></Button>
     <Button Style="{StaticResource RowIcon}" Command="{Binding CopyCommand}" ToolTip="Copy clip" AutomationProperties.Name="Copy clip"><Path Data="{StaticResource CopyIcon}" Width="17" Height="18" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/></Button>
     <Button Style="{StaticResource RowIcon}" Command="{Binding PinCommand}" ToolTip="{Binding PinLabel}" AutomationProperties.Name="{Binding PinLabel}"><Path Data="M6,2 L14,2 13,8 17,12 3,12 7,8 Z M10,12 L10,20" Width="16" Height="18" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.5"><Path.Style><Style TargetType="Path"><Setter Property="Fill" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding Pinned}" Value="True"><Setter Property="Fill" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Button>
     <Button Style="{StaticResource DeleteAction}" Command="{Binding DeleteCommand}" ToolTip="Delete clip" AutomationProperties.Name="Delete clip"><Path Data="{StaticResource DeleteIcon}" Width="16" Height="18" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/></Button>
    </StackPanel>
   </Grid>
  </Border>
 </DataTemplate>
 </ResourceDictionary></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,12,0"><TextBox x:Name="SearchBox" Style="{StaticResource MainTextBox}" Height="44" Padding="12,2" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search clipboard history"/>
    <TextBlock Text="Search clipboard…  Ctrl+F" Foreground="{StaticResource Muted}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </Grid>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="All" Command="{Binding AllCommand}" Margin="0,0,6,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource MainButton}"><Style.Triggers><DataTrigger Binding="{Binding AllSelected}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="From PC" Command="{Binding PcCommand}" Margin="0,0,6,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource MainButton}"><Style.Triggers><DataTrigger Binding="{Binding PcSelected}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="From phone" Command="{Binding PhoneCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource MainButton}"><Style.Triggers><DataTrigger Binding="{Binding PhoneSelected}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel>
  </Grid>
  <StackPanel Grid.Row="1"><DockPanel Visibility="{Binding IsPaused,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Resume sync" Command="{Binding ResumeCommand}"/><TextBlock Text="Sync is paused. Saved clips are still available." Foreground="{StaticResource Paused}" VerticalAlignment="Center"/></DockPanel><DockPanel Visibility="{Binding IsOff,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Turn on history" Command="{Binding EnableCommand}"/><TextBlock Text="History is off. New clips won’t be saved." Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel></StackPanel>
  <Grid Grid.Row="2"><ListBox x:Name="HistoryList" ItemsSource="{Binding Items}" Visibility="{Binding HasRows,Converter={StaticResource BoolVisibility}}" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" HorizontalContentAlignment="Stretch"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/></Style></ListBox.ItemContainerStyle></ListBox>
   <StackPanel Visibility="{Binding ShowEmpty,Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"><TextBlock Text="{Binding EmptyTitle}" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/></StackPanel>
  </Grid>
  <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Clear history" Foreground="{StaticResource Danger}" Command="{Binding ClearCommand}" IsEnabled="{Binding CanClear}"/><TextBlock Text="{Binding CountText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel></Border>
 </Grid>
</UserControl>
