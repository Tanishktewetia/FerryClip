<UserControl x:Class="ClipSync.Windows.MainUI.Pages.Settings.SettingsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="Transparent">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="../../Theme/Tokens.xaml"/>
    <ResourceDictionary Source="../../Theme/Controls.xaml"/>
    <ResourceDictionary Source="../../Theme/Icons.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="SettingRow" TargetType="Border"><Setter Property="MinHeight" Value="68"/><Setter Property="Padding" Value="0,8"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style x:Key="LastSettingRow" TargetType="Border" BasedOn="{StaticResource SettingRow}"><Setter Property="BorderThickness" Value="0"/></Style>

  <Geometry x:Key="PowerRowIcon">M10,1 L10,10 M5,3 A9,9 0 1 0 15,3</Geometry>
  <Geometry x:Key="TrayRowIcon">M2,4 L2,17 18,17 18,4 M6,10 L10,14 14,10 M10,14 L10,2</Geometry>
  <Geometry x:Key="ClipboardRowIcon">M6,3 L6,1 14,1 14,3 17,3 17,19 3,19 3,3 Z M6,11 L14,11 M11,8 L14,11 11,14</Geometry>
  <Geometry x:Key="PauseRowIcon">M5,3 L8,3 8,17 5,17 Z M12,3 L15,3 15,17 12,17 Z</Geometry>
  <Geometry x:Key="StackRowIcon">M2,6 L10,2 18,6 10,10 Z M2,10 L10,14 18,10 M2,14 L10,18 18,14</Geometry>
  <Geometry x:Key="TimerRowIcon">M7,1 L13,1 M10,4 L10,10 14,12 M10,3 A8,8 0 1 0 10.01,3</Geometry>
  <Geometry x:Key="ShieldRowIcon">M10,1 L18,4 17,11 Q16,17 10,20 Q4,17 3,11 L2,4 Z M6,10 L9,13 14,8</Geometry>
  <Geometry x:Key="LockRowIcon">M4,9 L16,9 16,18 4,18 Z M6,9 L6,6 A4,4 0 0 1 14,6 L14,9 M10,12 L10,15</Geometry>
  <Geometry x:Key="PlugRowIcon">M7,2 L7,7 M13,2 L13,7 M4,7 L16,7 16,10 C16,13 14,15 11,15 L11,18 9,18 9,15 C6,15 4,13 4,10 Z</Geometry>
  <Geometry x:Key="FirewallRowIcon">M10,1 L18,4 17,11 Q16,17 10,20 Q4,17 3,11 L2,4 Z M8,8 C8,5 13,5 13,8 L10,10 10,12 M10,15 L10,16</Geometry>
  <Geometry x:Key="ChevronRowIcon">M3,6 L9,12 15,6</Geometry>
  <Geometry x:Key="CheckRowIcon">M2,7 L6,11 14,2</Geometry>
  <Style x:Key="SettingsToggleRow" TargetType="CheckBox" BasedOn="{StaticResource {x:Type Control}}"><Setter Property="MinHeight" Value="68"/><Setter Property="Padding" Value="0"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Row" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" CornerRadius="4"><Grid MinHeight="68"><ContentPresenter Margin="0,0,58,0" VerticalAlignment="Center" /><Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="{StaticResource Line}" HorizontalAlignment="Right" Margin="0,0,4,0"><Ellipse x:Name="Thumb" Width="14" Height="14" Fill="{StaticResource Text}" HorizontalAlignment="Left" Margin="3"/></Border></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Fill" Value="{StaticResource AccentText}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#182A2F36"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger><Trigger Property="Tag" Value="Last"><Setter TargetName="Row" Property="BorderThickness" Value="0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SettingsValueCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="MinWidth" Value="116"/><Setter Property="Padding" Value="10,6"/><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="Padding" Value="10,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center"/><Path x:Name="SelectedMark" Grid.Column="1" Data="{StaticResource CheckRowIcon}" Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="2" Visibility="Collapsed"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource Raised}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="DropDownToggle" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Focusable="False" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentStringFormat="{TemplateBinding ItemStringFormat}" VerticalAlignment="Center"/><Path Grid.Column="1" Data="{StaticResource ChevronRowIcon}" Width="12" Height="8" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.8" Focusable="False"/></Grid></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="5" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="260" CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource MainButton}"><Setter Property="Foreground" Value="{StaticResource Danger}"/><Setter Property="BorderBrush" Value="{StaticResource Danger}"/><Setter Property="Background" Value="Transparent"/></Style>
  <Style x:Key="SectionCaption" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="RowIcon" TargetType="Path"><Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="{StaticResource Muted}"/><Setter Property="StrokeThickness" Value="1.4"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,14,0"/></Style>
  <Style x:Key="RowTitle" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,3"/></Style>
  <Style x:Key="RowDescription" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="DangerRowIcon" TargetType="Path" BasedOn="{StaticResource RowIcon}"><Setter Property="Stroke" Value="{StaticResource Danger}"/></Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid ClipToBounds="True"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel x:Name="SettingsContent" HorizontalAlignment="Stretch">
   <Border Style="{StaticResource SettingsCard}">
    <StackPanel>
     <TextBlock Text="General" Style="{StaticResource SectionTitle}"/><TextBlock Text="Manage startup and window behavior" Style="{StaticResource SectionCaption}"/>
     <CheckBox Style="{StaticResource SettingsToggleRow}" Tag="{StaticResource PowerRowIcon}" IsChecked="{Binding StartWithWindows,Mode=TwoWay}" ToolTip="Start FerryClip when you sign in" AutomationProperties.Name="Start with Windows"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><Path Data="{Binding Tag,RelativeSource={RelativeSource AncestorType=CheckBox}}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}"/><TextBlock Text="Uses the current user's Windows startup registration." Style="{StaticResource RowDescription}"/></StackPanel></Grid></CheckBox>
     <CheckBox Style="{StaticResource SettingsToggleRow}" Tag="{StaticResource TrayRowIcon}" IsChecked="{Binding CloseToTray,Mode=TwoWay}" ToolTip="Close the window to the system tray" AutomationProperties.Name="Close to tray"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><Path Data="{Binding Tag,RelativeSource={RelativeSource AncestorType=CheckBox}}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Close to tray" Style="{StaticResource RowTitle}"/><TextBlock Text="Keep FerryClip running when its window is closed." Style="{StaticResource RowDescription}"/></StackPanel></Grid></CheckBox>
    </StackPanel>
   </Border>

   <Border Style="{StaticResource SettingsCard}">
    <StackPanel>
     <TextBlock Text="Sync" Style="{StaticResource SectionTitle}"/><TextBlock Text="Control clipboard synchronization" Style="{StaticResource SectionCaption}"/>
<CheckBox Style="{StaticResource SettingsToggleRow}" Tag="{StaticResource ClipboardRowIcon}" IsChecked="{Binding AutoCopyReceived,Mode=TwoWay}" ToolTip="Auto-copy received clips" AutomationProperties.Name="Auto-copy received clips"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><Path Data="{Binding Tag,RelativeSource={RelativeSource AncestorType=CheckBox}}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Auto-copy received clips" Style="{StaticResource RowTitle}"/><TextBlock Text="Apply incoming text to the PC clipboard automatically." Style="{StaticResource RowDescription}"/></StackPanel></Grid></CheckBox>
     <!-- Auto-copy received is intentionally hidden: AppState currently rejects disabling it. TODO: add only after receive acknowledgement semantics exist. -->
     <CheckBox Style="{StaticResource SettingsToggleRow}" Tag="{StaticResource PauseRowIcon}" IsChecked="{Binding PauseAll,Mode=TwoWay}" ToolTip="Pause clipboard sync" AutomationProperties.Name="Pause syncing"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><Path Data="{Binding Tag,RelativeSource={RelativeSource AncestorType=CheckBox}}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Pause syncing" Style="{StaticResource RowTitle}"/><TextBlock Text="Temporarily stop clipboard sync with all devices" Style="{StaticResource RowDescription}"/></StackPanel></Grid></CheckBox>
    </StackPanel>
   </Border>

   <Border Style="{StaticResource SettingsCard}">
    <StackPanel>
     <TextBlock Text="Clipboard history" Style="{StaticResource SectionTitle}"/><TextBlock Text="Choose what is saved and for how long" Style="{StaticResource SectionCaption}"/>
     <CheckBox Style="{StaticResource SettingsToggleRow}" Tag="{StaticResource HistoryIcon}" IsChecked="{Binding SaveHistory,Mode=TwoWay}" ToolTip="Save clipboard history" AutomationProperties.Name="Save clipboard history"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><Path Data="{Binding Tag,RelativeSource={RelativeSource AncestorType=CheckBox}}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Save clipboard history" Style="{StaticResource RowTitle}"/><TextBlock Text="Store encrypted clipboard text on this PC." Style="{StaticResource RowDescription}"/></StackPanel></Grid></CheckBox>
     <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource StackRowIcon}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="History limit" Style="{StaticResource RowTitle}"/><TextBlock Text="Keep up to this many saved clips." Style="{StaticResource RowDescription}"/></StackPanel><ComboBox Grid.Column="2" Style="{StaticResource SettingsValueCombo}" Width="132" ItemStringFormat="{}{0} items" ItemsSource="{Binding HistoryLimits}" SelectedItem="{Binding HistoryLimit,Mode=TwoWay}" VerticalAlignment="Center"/></Grid></Border>
     <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource TimerRowIcon}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Auto-delete" Style="{StaticResource RowTitle}"/><TextBlock Text="Remove saved clips after the selected period." Style="{StaticResource RowDescription}"/></StackPanel><ComboBox Grid.Column="2" Style="{StaticResource SettingsValueCombo}" Width="172" ItemsSource="{Binding RetentionOptions}" SelectedItem="{Binding Retention,Mode=TwoWay}" VerticalAlignment="Center"/></Grid></Border>
     <Border Style="{StaticResource LastSettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource DeleteIcon}" Style="{StaticResource DangerRowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Clear history" Style="{StaticResource RowTitle}"/><TextBlock Text="Remove saved clips after confirmation; pinned clips stay." Style="{StaticResource RowDescription}"/></StackPanel><Button Grid.Column="2" Content="Clear history" Command="{Binding ClearHistoryCommand}" Style="{StaticResource DangerButton}" VerticalAlignment="Center"/></Grid></Border>
    </StackPanel>
   </Border>

   <Border Style="{StaticResource SettingsCard}">
    <StackPanel>
     <TextBlock Text="Privacy &amp; security" Style="{StaticResource SectionTitle}"/><TextBlock Text="Control what is saved and how it travels" Style="{StaticResource SectionCaption}"/>
     <CheckBox Style="{StaticResource SettingsToggleRow}" Tag="{StaticResource ShieldRowIcon}" IsChecked="{Binding SkipSensitive,Mode=TwoWay}" ToolTip="Skip sensitive clips" AutomationProperties.Name="Skip sensitive clips"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><Path Data="{Binding Tag,RelativeSource={RelativeSource AncestorType=CheckBox}}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Skip sensitive clips" Style="{StaticResource RowTitle}"/><TextBlock Text="Exclude recognized sensitive text from saved clipboard history." Style="{StaticResource RowDescription}"/></StackPanel></Grid></CheckBox>
     <Border Style="{StaticResource LastSettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><Path Data="{StaticResource LockRowIcon}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Encrypted, local-only transport" Style="{StaticResource RowTitle}"/><TextBlock Text="FerryClip uses mutually authenticated TLS 1.3 on your local network; clipboard text is not routed through a cloud service." Style="{StaticResource RowDescription}"/></StackPanel></Grid></Border>
    </StackPanel>
   </Border>

   <Border Style="{StaticResource SettingsCard}">
    <StackPanel>
     <TextBlock Text="Network" Style="{StaticResource SectionTitle}"/><TextBlock Text="Connection and troubleshooting options" Style="{StaticResource SectionCaption}"/>

     <Border Style="{StaticResource LastSettingRow}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource FirewallRowIcon}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Firewall &amp; troubleshooting" Style="{StaticResource RowTitle}"/><TextBlock Text="Connection help for private local networks." Style="{StaticResource RowDescription}"/></StackPanel><Button Grid.Column="2" Content="{Binding FirewallHelpLabel}" Command="{Binding ToggleFirewallHelpCommand}" VerticalAlignment="Center"/></Grid><Border Margin="32,8,0,0" Padding="14" Background="{StaticResource Raised}" CornerRadius="8" Visibility="{Binding FirewallHelpExpanded,Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}"><Run Text="Allow FerryClip on private networks in Windows Firewall (TCP port "/><Run Text="{Binding Port, Mode=OneWay}"/><Run Text="). Keep both devices on the same local network, then retry pairing."/></TextBlock><Button Content="Open troubleshooting guide" Command="{Binding OpenTroubleshootingCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></Border>
    </StackPanel>
   </Border>

   <Border Style="{StaticResource SettingsCard}">
    <StackPanel>
     <TextBlock Text="Updates" Style="{StaticResource SectionTitle}"/><TextBlock Text="Check FerryClip version and releases" Style="{StaticResource SectionCaption}"/>
     <Border Style="{StaticResource LastSettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource AboutIcon}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="FerryClip version" Style="{StaticResource RowTitle}"/><TextBlock Text="{Binding Version,StringFormat=Installed version {0}}" Style="{StaticResource RowDescription}"/></StackPanel><Button Grid.Column="2" Content="View latest release" Command="{Binding OpenLatestReleaseCommand}" VerticalAlignment="Center"/></Grid></Border>
    </StackPanel>
   </Border>

   <!-- Theme selection remains hidden while FerryClip is dark-only. TODO: expose after a complete light-theme token set exists. -->
  </StackPanel>
 </ScrollViewer><Border Height="16" VerticalAlignment="Top" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF1A1D21" Offset="0"/><GradientStop Color="#001A1D21" Offset="1"/></LinearGradientBrush></Border.Background></Border>
  <Border Height="16" VerticalAlignment="Bottom" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#001A1D21" Offset="0"/><GradientStop Color="#FF1A1D21" Offset="1"/></LinearGradientBrush></Border.Background></Border>
 </Grid>
</UserControl>
