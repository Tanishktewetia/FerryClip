<UserControl x:Class="ClipSync.Windows.MainUI.Pages.Settings.SettingsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="Transparent">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="../../Theme/Tokens.xaml"/>
    <ResourceDictionary Source="../../Theme/Controls.xaml"/>
    <ResourceDictionary Source="../../Theme/Icons.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="SettingRow" TargetType="Border"><Setter Property="MinHeight" Value="68"/><Setter Property="Padding" Value="0,8"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style x:Key="LastSettingRow" TargetType="Border" BasedOn="{StaticResource SettingRow}"><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="RowIcon" TargetType="Path"><Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="{StaticResource Muted}"/><Setter Property="StrokeThickness" Value="1.4"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,14,0"/></Style>
  <Style x:Key="RowTitle" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,3"/></Style>
  <Style x:Key="RowDescription" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel x:Name="SettingsContent" MaxWidth="760" HorizontalAlignment="Left">
   <Border Style="{StaticResource SettingsCard}">
    <StackPanel>
     <TextBlock Text="General" Style="{StaticResource SectionTitle}"/>
     <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource SettingsIcon}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}"/><TextBlock Text="Uses the current user's Windows startup registration." Style="{StaticResource RowDescription}"/></StackPanel><CheckBox Grid.Column="2" IsChecked="{Binding StartWithWindows,Mode=TwoWay}" VerticalAlignment="Center" ToolTip="Start FerryClip when you sign in"/></Grid></Border>
     <Border Style="{StaticResource LastSettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource AboutIcon}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Close to tray" Style="{StaticResource RowTitle}"/><TextBlock Text="Keep FerryClip running when its window is closed." Style="{StaticResource RowDescription}"/></StackPanel><CheckBox Grid.Column="2" IsChecked="{Binding CloseToTray,Mode=TwoWay}" VerticalAlignment="Center" ToolTip="Close the window to the system tray"/></Grid></Border>
    </StackPanel>
   </Border>

   <Border Style="{StaticResource SettingsCard}">
    <StackPanel>
     <TextBlock Text="Sync" Style="{StaticResource SectionTitle}"/>
<Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource HistoryIcon}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1"><TextBlock Text="Auto-copy received clips" Style="{StaticResource RowTitle}"/><TextBlock Text="Apply incoming text to the PC clipboard automatically." Style="{StaticResource RowDescription}"/></StackPanel><CheckBox Grid.Column="2" IsChecked="{Binding AutoCopyReceived}" VerticalAlignment="Center" AutomationProperties.Name="Auto-copy received clips"/></Grid></Border>
     <!-- Auto-copy received is intentionally hidden: AppState currently rejects disabling it. TODO: add only after receive acknowledgement semantics exist. -->
     <Border Style="{StaticResource LastSettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource DevicesIcon}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Pause all sync" Style="{StaticResource RowTitle}"/><TextBlock Text="Mirrors the global pause state used throughout FerryClip." Style="{StaticResource RowDescription}"/></StackPanel><CheckBox Grid.Column="2" IsChecked="{Binding PauseAll,Mode=TwoWay}" VerticalAlignment="Center" ToolTip="Pause clipboard sync"/></Grid></Border>
    </StackPanel>
   </Border>

   <Border Style="{StaticResource SettingsCard}">
    <StackPanel>
     <TextBlock Text="Clipboard history" Style="{StaticResource SectionTitle}"/>
     <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource HistoryIcon}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Save clipboard history" Style="{StaticResource RowTitle}"/><TextBlock Text="Store encrypted clipboard text on this PC." Style="{StaticResource RowDescription}"/></StackPanel><CheckBox Grid.Column="2" IsChecked="{Binding SaveHistory,Mode=TwoWay}" VerticalAlignment="Center"/></Grid></Border>
     <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource HistoryIcon}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="History limit" Style="{StaticResource RowTitle}"/><TextBlock Text="Keep up to this many saved clips." Style="{StaticResource RowDescription}"/></StackPanel><ComboBox Grid.Column="2" Width="116" ItemsSource="{Binding HistoryLimits}" SelectedItem="{Binding HistoryLimit,Mode=TwoWay}" VerticalAlignment="Center"/></Grid></Border>
     <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource HistoryIcon}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Auto-delete" Style="{StaticResource RowTitle}"/><TextBlock Text="Remove saved clips after the selected period." Style="{StaticResource RowDescription}"/></StackPanel><ComboBox Grid.Column="2" Width="156" ItemsSource="{Binding RetentionOptions}" SelectedItem="{Binding Retention,Mode=TwoWay}" VerticalAlignment="Center"/></Grid></Border>
     <Border Style="{StaticResource LastSettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource DeleteIcon}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Clear history" Style="{StaticResource RowTitle}"/><TextBlock Text="Remove saved clips after confirmation; pinned clips stay." Style="{StaticResource RowDescription}"/></StackPanel><Button Grid.Column="2" Content="Clear history" Command="{Binding ClearHistoryCommand}" Foreground="{StaticResource Danger}" VerticalAlignment="Center"/></Grid></Border>
    </StackPanel>
   </Border>

   <Border Style="{StaticResource SettingsCard}">
    <StackPanel>
     <TextBlock Text="Privacy &amp; security" Style="{StaticResource SectionTitle}"/>
     <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource SettingsIcon}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Skip sensitive clips" Style="{StaticResource RowTitle}"/><TextBlock Text="Exclude recognized sensitive text from saved clipboard history." Style="{StaticResource RowDescription}"/></StackPanel><CheckBox Grid.Column="2" IsChecked="{Binding SkipSensitive,Mode=TwoWay}" VerticalAlignment="Center"/></Grid></Border>
     <Border Style="{StaticResource LastSettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><Path Data="{StaticResource AboutIcon}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Encrypted, local-only transport" Style="{StaticResource RowTitle}"/><TextBlock Text="FerryClip uses mutually authenticated TLS 1.3 on your local network; clipboard text is not routed through a cloud service." Style="{StaticResource RowDescription}"/></StackPanel></Grid></Border>
    </StackPanel>
   </Border>

   <Border Style="{StaticResource SettingsCard}">
    <StackPanel>
     <TextBlock Text="Network" Style="{StaticResource SectionTitle}"/>
     <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource DevicesIcon}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Connection port" Style="{StaticResource RowTitle}"/><TextBlock Text="Read-only TCP port used on the local network." Style="{StaticResource RowDescription}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Port}" FontFamily="Cascadia Code,Consolas" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/></Grid></Border>
     <Border Style="{StaticResource LastSettingRow}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource HelpIcon}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Firewall &amp; troubleshooting" Style="{StaticResource RowTitle}"/><TextBlock Text="Connection help for private local networks." Style="{StaticResource RowDescription}"/></StackPanel><Button Grid.Column="2" Content="{Binding FirewallHelpLabel}" Command="{Binding ToggleFirewallHelpCommand}" VerticalAlignment="Center"/></Grid><Border Margin="32,8,0,0" Padding="14" Background="{StaticResource Raised}" CornerRadius="8" Visibility="{Binding FirewallHelpExpanded,Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="Allow FerryClip on private networks in Windows Firewall. Keep both devices on the same local network, then retry pairing." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><Button Content="Open troubleshooting guide" Command="{Binding OpenTroubleshootingCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></Border>
    </StackPanel>
   </Border>

   <Border Style="{StaticResource SettingsCard}">
    <StackPanel>
     <TextBlock Text="Updates" Style="{StaticResource SectionTitle}"/>
     <Border Style="{StaticResource LastSettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="{StaticResource AboutIcon}" Style="{StaticResource RowIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="FerryClip version" Style="{StaticResource RowTitle}"/><TextBlock Text="{Binding Version,StringFormat=Installed version {0}}" Style="{StaticResource RowDescription}"/></StackPanel><Button Grid.Column="2" Content="View latest release" Command="{Binding OpenLatestReleaseCommand}" VerticalAlignment="Center"/></Grid></Border>
    </StackPanel>
   </Border>

   <!-- Theme selection remains hidden while FerryClip is dark-only. TODO: expose after a complete light-theme token set exists. -->
  </StackPanel>
 </ScrollViewer>
</UserControl>
