<Window x:Class="ClipSync.Windows.UI.StatusWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontSize="14" Focusable="False" Title="FerryClip" Width="400" SizeToContent="Height" WindowStartupLocation="Manual" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" UseLayoutRounding="True" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" Deactivated="Window_Deactivated" PreviewKeyDown="Window_KeyDown">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/FerryClip;component/Theme/PopoverStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border CornerRadius="12" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="8" Effect="{StaticResource PopoverShadow}">
 <StackPanel Margin="12">
  <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
   <Image Source="/FerryClip;component/Assets/ferryclip_logo.png" Width="32" Height="32" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
   <StackPanel Grid.Column="1"><TextBlock Text="FerryClip" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock x:Name="BuildLabel" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
   <Button Grid.Column="2" Click="Hide_Click" Style="{StaticResource PopoverButton}" Padding="8" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" AutomationProperties.Name="Close popover" ToolTip="Close"><TextBlock Text="&#xE8BB;" Style="{StaticResource PopoverIcon}" FontSize="12"/></Button>
  </Grid>
  <Border x:Name="StatusCard" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,6,0,0"/>
   <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock x:Name="StatusText" Text="No devices paired" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock x:Name="StatusDetail" Text="Pair your phone to start syncing" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/></StackPanel>
   <Button x:Name="SyncButton" Grid.Column="2" Click="Sync_Click" Style="{StaticResource PopoverButton}" VerticalAlignment="Center" Visibility="Collapsed"/>
  </Grid></Border>
  <StackPanel x:Name="DevicesSection" Visibility="Collapsed" Margin="0,0,0,8"><TextBlock Text="YOUR DEVICES" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/><StackPanel x:Name="PhoneTiles"/></StackPanel>
  <Button x:Name="PairToggle" Click="PairToggle_Click" Style="{StaticResource PopoverButton}" HorizontalContentAlignment="Stretch" Margin="0,0,0,8" AutomationProperties.Name="Expand pairing panel">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions><TextBlock Text="&#xE710;" Style="{StaticResource PopoverIcon}"/><TextBlock Grid.Column="1" Text="Pair new device" VerticalAlignment="Center"/><TextBlock x:Name="PairChevron" Grid.Column="2" Text="&#xE70D;" Style="{StaticResource PopoverIcon}" FontSize="12"/></Grid>
  </Button>
  <Border x:Name="PairPanel" Height="0" ClipToBounds="True" Background="{StaticResource SurfaceBrush}" CornerRadius="8"><StackPanel x:Name="PairContent" Margin="8">
   <StackPanel x:Name="ActiveCodeRow" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,4">
    <TextBlock x:Name="PairCodeText" FontFamily="Consolas" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
    <Button x:Name="CopyCodeButton" Click="CopyCode_Click" Style="{StaticResource PopoverButton}" Padding="8" Margin="8,0,0,0" AutomationProperties.Name="Copy pairing code" ToolTip="Copy pairing code"><TextBlock Text="&#xE8C8;" Style="{StaticResource PopoverIcon}" FontSize="14"/></Button>
   </StackPanel>
   <TextBlock x:Name="PairHelpText" Text="Creates a six-digit code to pair your phone" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
   <TextBlock x:Name="PairExpiryText" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,8"/>
   <Button x:Name="GenerateButton" Content="Generate code" Click="Pair_Click" Style="{StaticResource PopoverPrimaryButton}"/>
  </StackPanel></Border>  <Button x:Name="OpenButton" Click="OpenFerryClip_Click" Style="{StaticResource PopoverPrimaryButton}" Margin="0,8,0,0" ToolTip="Open the full FerryClip application"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource PopoverIcon}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Open FerryClip" VerticalAlignment="Center"/></StackPanel></Button>
 </StackPanel></Border>
</Window>
